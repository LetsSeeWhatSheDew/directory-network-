{
  "name": "project-green",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:ci": "node tests/ci/lint-ratchet.mjs",
    "lint:baseline": "node tests/ci/lint-ratchet.mjs --update",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "build:fixtures": "node tests/fixtures/with-mock.mjs next build",
    "test:e2e": "playwright test",
    "test:perf": "node tests/perf/lighthouse-budget.mjs",
    "smoke": "node tests/smoke.mjs",
    "test:scrapers": "tsx --test tests/scrapers.test.ts tests/scraper-runs.test.ts tests/scrapers.browser.test.ts",
    "scrape:cil": "tsx scripts/scrape-cil-deals.ts",
    "scrape:cil:dry": "tsx scripts/scrape-cil-deals.ts --dry-run",
    "scrape:cil:live": "tsx scripts/scrape-cil-deals.ts --live --apply"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.49.0",
    "@supabase/supabase-js": "^2.102.1",
    "@types/leaflet": "^1.9.21",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.471.2",
    "next": "16.3.6",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "resend": "^6.12.0",
    "server-only": "^0.0.1",
    "stripe": "^22.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "lighthouse": "12.8.2",
    "playwright-core": "1.56",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
